{
  "name": "Automate Amazon with ScrapeHero",
  "nodes": [
    {
      "parameters": {},
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "documentId": "YOUR_DOCUMENT_ID",
        "sheetName": "Queries"
      },
      "name": "Get Queries",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        200,
        0
      ]
    },
    {
      "parameters": {
        "options": {}
      },
      "name": "Loop Over Items",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        400,
        0
      ]
    },
    {
      "parameters": {
        "apiSelection": "Amazon Offer Listing API",
        "textInput": "{{ $json.query }}",
        "countryCode": "US"
      },
      "name": "ScrapeHero",
      "type": "n8n-nodes-scrapehero.scrapeHero",
      "typeVersion": 1,
      "position": [
        600,
        0
      ],
      "credentials": {
        "scrapeHeroApi": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "ScrapeHero account"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": 0,
              "name": "asin",
              "value": "{{ $json.asin }}"
            },
            {
              "id": 1,
              "name": "product_title",
              "value": "{{ $json.product_title }}"
            },
            {
              "id": 2,
              "name": "product_rating",
              "value": "{{ $json.product_rating }}"
            },
            {
              "id": 3,
              "name": "product_ratings_count",
              "value": "{{ $json.product_ratings_count }}"
            },
            {
              "id": 4,
              "name": "url",
              "value": "{{ $json.url }}"
            },
            {
              "id": 5,
              "name": "next",
              "value": "{{ $json.next }}"
            },
            {
              "id": 6,
              "name": "offer_listings",
              "value": "{{ $json.offer_listings }}"
            }
          ]
        }
      },
      "name": "Edit Fields",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [
        800,
        0
      ]
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": "YOUR_DOCUMENT_ID",
        "sheetName": "Results",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "asin": "{{ $json.asin }}",
            "product_title": "{{ $json.product_title }}",
            "product_rating": "{{ $json.product_rating }}",
            "product_ratings_count": "{{ $json.product_ratings_count }}",
            "url": "{{ $json.url }}",
            "next": "{{ $json.next }}",
            "offer_listings": "{{ $json.offer_listings }}"
          },
          "matchingColumns": [
            "ASIN"
          ]
        }
      },
      "name": "Update Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        1000,
        0
      ]
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Get Queries",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Queries": {
      "main": [
        [
          {
            "node": "Loop Over Items",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Loop Over Items": {
      "main": [
        [],
        [
          {
            "node": "ScrapeHero",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "ScrapeHero": {
      "main": [
        [
          {
            "node": "Edit Fields",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Edit Fields": {
      "main": [
        [
          {
            "node": "Update Sheets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Update Sheets": {
      "main": [
        [
          {
            "node": "Loop Over Items",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {}
}