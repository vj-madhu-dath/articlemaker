{
  "name": "Amazon Offer Listing - Find Lowest New Price",
  "nodes": [
    {
      "parameters": {},
      "id": "manual-trigger-1",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "operation": "getAll",
        "documentId": "YOUR_DOCUMENT_ID",
        "sheetName": "ASINs"
      },
      "id": "google-sheets-get-asins",
      "name": "Get ASINs",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [220, 0],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "YOUR_GOOGLE_SHEETS_CREDENTIAL_ID",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "loop-over-items-1",
      "name": "Loop Over Items",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [440, 0]
    },
    {
      "parameters": {
        "apiSelection": "Amazon Offer Listing",
        "asin": "={{ $json.ASIN }}",
        "countryCode": "US"
      },
      "id": "scrapehero-offer-listing",
      "name": "ScrapeHero",
      "type": "n8n-nodes-scrapehero.scrapeHero",
      "typeVersion": 1,
      "position": [660, 0],
      "credentials": {
        "scrapeHeroApi": {
          "id": "YOUR_SCRAPEHERO_CREDENTIAL_ID",
          "name": "ScrapeHero account"
        }
      }
    },
    {
      "parameters": {
        "operation": "splitOutItems",
        "fieldToSplitOut": "offer_listings",
        "options": {}
      },
      "id": "split-out-offers",
      "name": "Split Out",
      "type": "n8n-nodes-base.itemLists",
      "typeVersion": 3,
      "position": [880, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "filter-cond-1",
              "leftValue": "={{ $json.condition }}",
              "rightValue": "New",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "id": "filter-new-offers",
      "name": "Filter",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [1100, 0]
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "edit-field-price",
              "name": "Price",
              "value": "={{ Number($json.price.replace(/[^0-9.]/g, '')) }}",
              "type": "number"
            }
          ]
        },
        "options": {
          "includeOtherFields": true
        }
      },
      "id": "edit-fields-price",
      "name": "Edit Fields1",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1320, 0]
    },
    {
      "parameters": {
        "type": "simple",
        "fieldsToCompare": {
          "fields": [
            {
              "fieldName": "Price",
              "order": "ascending"
            }
          ]
        }
      },
      "id": "sort-offers-price",
      "name": "Sort",
      "type": "n8n-nodes-base.sort",
      "typeVersion": 1,
      "position": [1540, 0]
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": "YOUR_DOCUMENT_ID",
        "sheetName": "ASINs",
        "columns": {
          "mappingMode": "defineBelow",
          "matchingColumns": [
            "ASIN"
          ],
          "value": {
            "ASIN": "={{ $('ScrapeHero').item.json.asin }}",
            "Name": "={{ $('ScrapeHero').item.json.product_title }}",
            "Lowest New Price": "={{ $json.Price }}"
          }
        }
      },
      "id": "update-google-sheets",
      "name": "Update Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1760, 0],
      "executeOnce": true,
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "YOUR_GOOGLE_SHEETS_CREDENTIAL_ID",
          "name": "Google Sheets account"
        }
      }
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Get ASINs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get ASINs": {
      "main": [
        [
          {
            "node": "Loop Over Items",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Loop Over Items": {
      "main": [
        [],
        [
          {
            "node": "ScrapeHero",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "ScrapeHero": {
      "main": [
        [
          {
            "node": "Split Out",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split Out": {
      "main": [
        [
          {
            "node": "Filter",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter": {
      "main": [
        [
          {
            "node": "Edit Fields1",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Edit Fields1": {
      "main": [
        [
          {
            "node": "Sort",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sort": {
      "main": [
        [
          {
            "node": "Update Sheets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Update Sheets": {
      "main": [
        [
          {
            "node": "Loop Over Items",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {}
}
